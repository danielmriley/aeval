; Zero-extend version of cex1: single variable x, property uses zero_extend
; Equivalent to bv4096_cex1.smt2 but with pure BV property (no bv2int)
;
; Original property: (not (< (+ 1 (bv2int x)) 2^4096))
; With zero_extend: NOT(bvult(bvadd(zext(x), 1), 2^4096))
;
; Trace: x=0,1,2,...,2^4096-1 (2^4096 states)

(set-logic HORN)

(declare-fun inv ((_ BitVec 4096)) Bool)

; Initial state: x = 0
(assert 
  (inv #)
)

; Transition: x' = x + 1
(assert 
  (forall ((x (_ BitVec 4096)) (x_next (_ BitVec 4096)))
    (=> (and (inv x)
             (= x_next (bvadd x #)))
        (inv x_next))
  )
)

; Property: zero_extend(x) + 1 < 2^4096 (violated when x = 2^4096-1)
(assert 
  (forall ((x (_ BitVec 4096)))
    (=> (and (inv x) 
             (not (bvult (bvadd ((_ zero_extend 4096) x) #) #)))
        false)
  )
)

(check-sat)
