; Zero-extend benchmark: 4096-bit values, 8192-bit counter
; Trace length: 2^4096 + 1 steps (0 to 2^4096)

(set-logic HORN)

(declare-fun inv ((_ BitVec 4096) (_ BitVec 8192)) Bool)

; Initial state: x = 0, counter = 0
(assert 
  (inv # #)
)

; Transition: x' = x + 1, counter' = counter + zero_extend(1)
(assert 
  (forall ((x (_ BitVec 4096)) (counter (_ BitVec 8192)) 
           (x_next (_ BitVec 4096)) (counter_next (_ BitVec 8192)))
    (=> (and (inv x counter)
             (= x_next (bvadd x #))
             (= counter_next (bvadd counter ((_ zero_extend 4096) #))))
        (inv x_next counter_next))
  )
)

; Property: counter < 2^k (should be violated after 2^k steps)
(assert 
  (forall ((x (_ BitVec 4096)) (counter (_ BitVec 8192)))
    (=> (inv x counter)
        (bvult counter #))
  )
)

(check-sat)
