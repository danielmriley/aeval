; Compact CEX for 8192-bit zero-extend benchmark
; Single variable x, BV index (replaces Int index from original)
;
; Value function: x at step i = extract(i) (lower 8192 bits of 16384-bit index)
; This is the BV equivalent of int2bv(i)
;
; Trace bounds: 0 to 2^8192-1 (2^8192 states)

(define-fun x_at_i ((i (_ BitVec 16384))) (_ BitVec 8192)
  ((_ extract 8191 0) i)
)

(declare-const trace (Array (_ BitVec 16384) (_ BitVec 8192)))

(assert 
  (forall ((i (_ BitVec 16384))) 
    (=> (and (bvule # i) (bvule i #)) 
        (= (select trace i) (x_at_i i))
    )
  )
)

(check-sat)
