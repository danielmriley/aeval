; Compact CEX for 1024-bit zero-extend benchmark
; Value functions:
;   x at step i = extract lower 1024 bits from 2048-bit index
;   counter at step i = i (the index itself)
; Trace bounds: 0 to 2^1024

(define-fun x_at_i ((i (_ BitVec 2048))) (_ BitVec 1024)
  ((_ extract 1023 0) i)
)

(define-fun counter_at_i ((i (_ BitVec 2048))) (_ BitVec 2048)
  i
)

(declare-const trace_x (Array (_ BitVec 2048) (_ BitVec 1024)))
(declare-const trace_counter (Array (_ BitVec 2048) (_ BitVec 2048)))

(assert 
  (forall ((i (_ BitVec 2048))) 
    (=> (and (bvule # i) (bvule i #)) 
        (and (= (select trace_x i) (x_at_i i))
             (= (select trace_counter i) (counter_at_i i)))
    )
  )
)

(check-sat)
