; Compact CEX for 1024-bit zero-extend benchmark
; Single variable x, BV index (replaces Int index from original)
;
; Value function: x at step i = extract(i) (lower 1024 bits of 2048-bit index)
; This is the BV equivalent of int2bv(i)
;
; Trace bounds: 0 to 2^1024-1 (2^1024 states)

(define-fun x_at_i ((i (_ BitVec 2048))) (_ BitVec 1024)
  ((_ extract 1023 0) i)
)

(declare-const trace (Array (_ BitVec 2048) (_ BitVec 1024)))

(assert 
  (forall ((i (_ BitVec 2048))) 
    (=> (and (bvule # i) (bvule i #)) 
        (= (select trace i) (x_at_i i))
    )
  )
)

(check-sat)
