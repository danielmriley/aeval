; Compact CEX for 2048-bit zero-extend benchmark
; Single variable x, BV index (replaces Int index from original)
;
; Value function: x at step i = extract(i) (lower 2048 bits of 4096-bit index)
; This is the BV equivalent of int2bv(i)
;
; Trace bounds: 0 to 2^2048-1 (2^2048 states)

(define-fun x_at_i ((i (_ BitVec 4096))) (_ BitVec 2048)
  ((_ extract 2047 0) i)
)

(declare-const trace (Array (_ BitVec 4096) (_ BitVec 2048)))

(assert 
  (forall ((i (_ BitVec 4096))) 
    (=> (and (bvule # i) (bvule i #)) 
        (= (select trace i) (x_at_i i))
    )
  )
)

(check-sat)
