; Compact CEX for 2048-bit zero-extend benchmark
; Value functions:
;   x at step i = extract lower 2048 bits from 4096-bit index
;   counter at step i = i (the index itself)
; Trace bounds: 0 to 2^2048

(define-fun x_at_i ((i (_ BitVec 4096))) (_ BitVec 2048)
  ((_ extract 2047 0) i)
)

(define-fun counter_at_i ((i (_ BitVec 4096))) (_ BitVec 4096)
  i
)

(declare-const trace_x (Array (_ BitVec 4096) (_ BitVec 2048)))
(declare-const trace_counter (Array (_ BitVec 4096) (_ BitVec 4096)))

(assert 
  (forall ((i (_ BitVec 4096))) 
    (=> (and (bvule # i) (bvule i #)) 
        (and (= (select trace_x i) (x_at_i i))
             (= (select trace_counter i) (counter_at_i i)))
    )
  )
)

(check-sat)
