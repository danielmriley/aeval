; Compact CEX for 4096-bit zero-extend benchmark
; Single variable x, BV index (replaces Int index from original)
;
; Value function: x at step i = extract(i) (lower 4096 bits of 8192-bit index)
; This is the BV equivalent of int2bv(i)
;
; Trace bounds: 0 to 2^4096-1 (2^4096 states)

(define-fun x_at_i ((i (_ BitVec 8192))) (_ BitVec 4096)
  ((_ extract 4095 0) i)
)

(declare-const trace (Array (_ BitVec 8192) (_ BitVec 4096)))

(assert 
  (forall ((i (_ BitVec 8192))) 
    (=> (and (bvule # i) (bvule i #)) 
        (= (select trace i) (x_at_i i))
    )
  )
)

(check-sat)
