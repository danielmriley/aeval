; Compact CEX for 4096-bit zero-extend benchmark
; Value functions:
;   x at step i = extract lower 4096 bits from 8192-bit index
;   counter at step i = i (the index itself)
; Trace bounds: 0 to 2^4096

(define-fun x_at_i ((i (_ BitVec 8192))) (_ BitVec 4096)
  ((_ extract 4095 0) i)
)

(define-fun counter_at_i ((i (_ BitVec 8192))) (_ BitVec 8192)
  i
)

(declare-const trace_x (Array (_ BitVec 8192) (_ BitVec 4096)))
(declare-const trace_counter (Array (_ BitVec 8192) (_ BitVec 8192)))

(assert 
  (forall ((i (_ BitVec 8192))) 
    (=> (and (bvule # i) (bvule i #)) 
        (and (= (select trace_x i) (x_at_i i))
             (= (select trace_counter i) (counter_at_i i)))
    )
  )
)

(check-sat)
