; Zero-extend version of cex1: single variable x, property uses zero_extend
; Equivalent to bv65536_cex1.smt2 but with pure BV property (no bv2int)
;
; Original property: (not (< (+ 1 (bv2int x)) 2^65536))
; With zero_extend: NOT(bvult(bvadd(zext(x), 1), 2^65536))
;
; Trace: x=0,1,2,...,2^65536-1 (2^65536 states)

(set-logic HORN)

(declare-fun inv ((_ BitVec 65536)) Bool)

; Initial state: x = 0
(assert 
  (inv #)
)

; Transition: x' = x + 1
(assert 
  (forall ((x (_ BitVec 65536)) (x_next (_ BitVec 65536)))
    (=> (and (inv x)
             (= x_next (bvadd x #)))
        (inv x_next))
  )
)

; Property: zero_extend(x) + 1 < 2^65536 (violated when x = 2^65536-1)
(assert 
  (forall ((x (_ BitVec 65536)))
    (=> (and (inv x) 
             (not (bvult (bvadd ((_ zero_extend 65536) x) #) #)))
        false)
  )
)

(check-sat)
