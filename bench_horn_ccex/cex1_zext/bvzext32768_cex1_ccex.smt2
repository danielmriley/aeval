; Compact CEX for 32768-bit zero-extend benchmark
; Single variable x, BV index (replaces Int index from original)
;
; Value function: x at step i = extract(i) (lower 32768 bits of 65536-bit index)
; This is the BV equivalent of int2bv(i)
;
; Trace bounds: 0 to 2^32768-1 (2^32768 states)

(define-fun x_at_i ((i (_ BitVec 65536))) (_ BitVec 32768)
  ((_ extract 32767 0) i)
)

(declare-const trace (Array (_ BitVec 65536) (_ BitVec 32768)))

(assert 
  (forall ((i (_ BitVec 65536))) 
    (=> (and (bvule # i) (bvule i #)) 
        (= (select trace i) (x_at_i i))
    )
  )
)

(check-sat)
