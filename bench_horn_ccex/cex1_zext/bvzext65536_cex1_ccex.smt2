; Compact CEX for 65536-bit zero-extend benchmark
; Single variable x, BV index (replaces Int index from original)
;
; Value function: x at step i = extract(i) (lower 65536 bits of 131072-bit index)
; This is the BV equivalent of int2bv(i)
;
; Trace bounds: 0 to 2^65536-1 (2^65536 states)

(define-fun x_at_i ((i (_ BitVec 131072))) (_ BitVec 65536)
  ((_ extract 65535 0) i)
)

(declare-const trace (Array (_ BitVec 131072) (_ BitVec 65536)))

(assert 
  (forall ((i (_ BitVec 131072))) 
    (=> (and (bvule # i) (bvule i #)) 
        (= (select trace i) (x_at_i i))
    )
  )
)

(check-sat)
