; Zero-extend benchmark: 2048-bit values, 4096-bit counter
; Trace length: 2^2048 + 1 steps (0 to 2^2048)

(set-logic HORN)

(declare-fun inv ((_ BitVec 2048) (_ BitVec 4096)) Bool)

; Initial state: x = 0, counter = 0
(assert 
  (inv # #)
)

; Transition: x' = x + 1, counter' = counter + zero_extend(1)
(assert 
  (forall ((x (_ BitVec 2048)) (counter (_ BitVec 4096)) 
           (x_next (_ BitVec 2048)) (counter_next (_ BitVec 4096)))
    (=> (and (inv x counter)
             (= x_next (bvadd x #))
             (= counter_next (bvadd counter ((_ zero_extend 2048) #))))
        (inv x_next counter_next))
  )
)

; Property: counter < 2^k (should be violated after 2^k steps)
(assert 
  (forall ((x (_ BitVec 2048)) (counter (_ BitVec 4096)))
    (=> (inv x counter)
        (bvult counter #))
  )
)

(check-sat)
