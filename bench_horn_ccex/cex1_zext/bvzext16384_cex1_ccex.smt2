; Compact CEX for 16384-bit zero-extend benchmark
; Single variable x, BV index (replaces Int index from original)
;
; Value function: x at step i = extract(i) (lower 16384 bits of 32768-bit index)
; This is the BV equivalent of int2bv(i)
;
; Trace bounds: 0 to 2^16384-1 (2^16384 states)

(define-fun x_at_i ((i (_ BitVec 32768))) (_ BitVec 16384)
  ((_ extract 16383 0) i)
)

(declare-const trace (Array (_ BitVec 32768) (_ BitVec 16384)))

(assert 
  (forall ((i (_ BitVec 32768))) 
    (=> (and (bvule # i) (bvule i #)) 
        (= (select trace i) (x_at_i i))
    )
  )
)

(check-sat)
