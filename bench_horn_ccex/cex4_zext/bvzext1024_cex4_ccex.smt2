; Compact CEX for 1024-bit cex4_zext: x increments by 2
; x_at_i(i) = 2*i = extract lower 1024 bits of (i shifted left by 1)
; Trace bounds: 0 to 2^1023-1

(define-fun x_at_i ((i (_ BitVec 2048))) (_ BitVec 1024)
  ((_ extract 1023 0) (bvshl i #))
)

(declare-const trace (Array (_ BitVec 2048) (_ BitVec 1024)))

(assert 
  (forall ((i (_ BitVec 2048))) 
    (=> (and (bvule # i) (bvule i #)) 
        (= (select trace i) (x_at_i i))
    )
  )
)

(check-sat)
