; Compact CEX for 1024-bit cex5_zext: x += 1, y += 2
; x_at_i(i) = extract(i), y_at_i(i) = extract(i << 1)
; Trace bounds: 0 to 2^1023-1

(define-fun x_at_i ((i (_ BitVec 2048))) (_ BitVec 1024)
  ((_ extract 1023 0) i)
)

(define-fun y_at_i ((i (_ BitVec 2048))) (_ BitVec 1024)
  ((_ extract 1023 0) (bvshl i #))
)

(declare-const trace_x (Array (_ BitVec 2048) (_ BitVec 1024)))
(declare-const trace_y (Array (_ BitVec 2048) (_ BitVec 1024)))

(assert 
  (forall ((i (_ BitVec 2048))) 
    (=> (and (bvule # i) (bvule i #)) 
        (and (= (select trace_x i) (x_at_i i))
             (= (select trace_y i) (y_at_i i)))
    )
  )
)

(check-sat)
