; INVALID CCEX: x(i) = i + 1 (Init violation)
(define-fun x_at_i ((i (_ BitVec 8))) (_ BitVec 8)
  (bvadd i #x01)
)
(declare-const trace (Array (_ BitVec 8) (_ BitVec 8)))
(assert (forall ((i (_ BitVec 8))) 
    (=> (and (bvule #x00 i) (bvule i #xff)) 
        (= (select trace i) (x_at_i i)))))
(check-sat)
